        <oboInOwl:hasDbXref>neuronames:156</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>pyramidal cell layer of the hippocampus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pyramidal layer of hippocampus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stratum pyramidale</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stratum pyramidale hippocampi</oboInOwl:hasExactSynonym>
