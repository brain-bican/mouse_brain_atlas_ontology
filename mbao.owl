        <skos:prefLabel>medial nasal prominence</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/8/85/Gray45.png</foaf:depiction>
    </owl:Class>
