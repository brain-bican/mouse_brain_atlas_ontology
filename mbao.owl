        <obo:IAO_0000115>Pia mater or arachnoid mater.</obo:IAO_0000115>
        <obo:IAO_0000116>check relationship to secondary meninx</obo:IAO_0000116>
        <obo:UBPROP_0000012>in FMA/NIF this is a superclass of PM/AM - in BTO it is the mereological sum. We go with superclass here, as we are naming the class in the singular</obo:UBPROP_0000012>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <oboInOwl:hasDbXref>BTO:0001634</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0546</oboInOwl:hasDbXref>
