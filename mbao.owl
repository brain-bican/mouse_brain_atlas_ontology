    <!-- http://purl.obolibrary.org/obo/UBERON_0005062 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002050"/>
