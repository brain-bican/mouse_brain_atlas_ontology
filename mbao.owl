    <!-- http://purl.obolibrary.org/obo/UBERON_0005370 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005370">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002305"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007640"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BSPO_0001107"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005368"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
