    <!-- http://purl.obolibrary.org/obo/UBERON_0022272 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0022272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007702"/>
        <rdfs:subClassOf rdf:nodeID="genid13639"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0036224"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The corticobulbar (or corticonuclear) tract is a white matter pathway connecting the cerebral cortex to the brainstem. The term &apos;bulbar&apos; refers to the brainstem, as &apos;bulb&apos; was a historical term meaning the area currently called the brainstem. The &apos;bulb&apos; is an archaic term for the medulla oblongata. In clinical usage, it includes the pons as well.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>DHBA:12774</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:275544</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:265505058</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:994</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Corticobulbar_tract</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1319</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>bulbar</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cbu-h</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cortico-bulbar tract</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>corticobulbar</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>corticobulbar axons</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>corticobulbar fiber</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>corticobulbar fibre</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>corticobulbar pathway</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>corticonuclear tract</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0022272</oboInOwl:id>
        <rdfs:label>corticobulbar tract</rdfs:label>
        <skos:prefLabel>corticobulbar tract</skos:prefLabel>
    </owl:Class>
