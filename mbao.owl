    <!-- http://purl.obolibrary.org/obo/CL_0000598 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000598">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_2000029"/>
        <obo:IAO_0000115>Pyramidal neurons have a pyramid-shaped soma with a single axon, a large apical dendrite and multiple basal dendrites. The apex and an apical dendrite typically point toward the pial surface and other dendrites and an axon emerging from the base. The axons may have local collaterals but also project outside their region. Pyramidal neurons are found in the cerebral cortex, the hippocampus, and the amygdala.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0003102</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:67310</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:86775</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NIFSTD:sao862606388</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009273</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>projection neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pyramidal cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#BDS_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>pyramidal neuron</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000598</rdfs:seeAlso>
        <skos:prefLabel>pyramidal neuron</skos:prefLabel>
    </owl:Class>
