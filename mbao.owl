    <!-- http://purl.obolibrary.org/obo/UBERON_0004139 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004139">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002050"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003084"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The first recognizable structure derived from the heart field.</obo:IAO_0000115>
        <obo:IAO_0000116>TODO - check plate vs rudiment vs primordium vs endocardial tube. See XAO</obo:IAO_0000116>
        <obo:UBPROP_0000003>(In vertebrates) The embryonic mesoderm is the source of both the cardiogenic plate, giving rise to the future myocardium as well as the endocardium that will line the system on the inner side.[well established][VHOG]</obo:UBPROP_0000003>
        <oboInOwl:hasDbXref>EHDAA2:0000215</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:16106</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000975</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>myocardial plate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>cardiac crescent</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cardiogenic crescent</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>heart rudiment</oboInOwl:hasRelatedSynonym>
