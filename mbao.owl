            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The region of a cerebellar lobule that resides in the central section of the cerebellum between the two hemispheres.</obo:IAO_0000115>
        <obo:IAO_0000116>TODO - define as a region overlapping</obo:IAO_0000116>
        <obo:UBPROP_0000008>in humans, vermis lobule regions may be nearly continuous with the cerebellar hemisphere lobules dorsally but are separated by deeper longitudinal fissues in the ventral regions; in mammals, the vermis portion of the cerebellum has a foliation pattern along the AP axis that is distinct from the lateral cerebellar hemispheres</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref>EMAPA:35224</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:278629</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002968</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NLXANAT:20081223</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lobule of vermis</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0004070</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
