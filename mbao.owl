    <!-- http://purl.obolibrary.org/obo/UBERON_0000451 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000451">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002616"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001870"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The anterior part of the frontal lobes of the brain, lying in front of the motor and premotor areas.nnThis brain region has been implicated in planning complex cognitive behaviors, personality expression, decision making and moderating correct social behavior. The basic activity of this brain region is considered to be orchestration of thoughts and actions in accordance with internal goals.nnThe most typical psychological term for functions carried out by the pre-frontal cortex area is executive function. Executive function relates to abilities to differentiate among conflicting thoughts, determine good and bad, better and best, same and different, future consequences of current activities, working toward a defined goal, prediction of outcomes, expectation based on actions, and social &apos;control&apos; (the ability to suppress urges that, if not suppressed, could lead to socially-unacceptable outcomes).nnMany authors have indicated an integral link between a person&apos;s personality and the functions of the prefrontal cortex. - definition adapted from Wikipedia.</obo:IAO_0000115>
        <obo:IAO_0000116>TODO - check MA</obo:IAO_0000116>
        <oboInOwl:hasDbXref>BAMS:FrA</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BTO:0002807</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:10172</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EFO:0001384</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:35356</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:224850</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:676</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000906</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D017397</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NLXANAT:090801</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Prefrontal_cortex</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1072</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>prefrontal association cortex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>frontal association cortex</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>prefrontal association complex</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0000451</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
        <rdfs:label>prefrontal cortex</rdfs:label>
        <skos:prefLabel>prefrontal cortex</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/5/59/Gray726-Brodman-prefrontal.svg</foaf:depiction>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000451"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The anterior part of the frontal lobes of the brain, lying in front of the motor and premotor areas.nnThis brain region has been implicated in planning complex cognitive behaviors, personality expression, decision making and moderating correct social behavior. The basic activity of this brain region is considered to be orchestration of thoughts and actions in accordance with internal goals.nnThe most typical psychological term for functions carried out by the pre-frontal cortex area is executive function. Executive function relates to abilities to differentiate among conflicting thoughts, determine good and bad, better and best, same and different, future consequences of current activities, working toward a defined goal, prediction of outcomes, expectation based on actions, and social &apos;control&apos; (the ability to suppress urges that, if not suppressed, could lead to socially-unacceptable outcomes).nnMany authors have indicated an integral link between a person&apos;s personality and the functions of the prefrontal cortex. - definition adapted from Wikipedia.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NLXANAT:090801</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000451"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>prefrontal association cortex</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FMA:224850</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000451"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>frontal association cortex</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MA:0000906</oboInOwl:hasDbXref>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/uberon/core#PENDING_REVIEW"/>
    </owl:Axiom>
    <owl:Axiom>
