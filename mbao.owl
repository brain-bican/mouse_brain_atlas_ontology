        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002380"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001759"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A branch of the vagus nerve that supplies motor function and sensation to the larynx (voice box). It travels within the endoneurium. It is the nerve of the 6th Branchial Arch.</obo:IAO_0000115>
        <obo:UBPROP_0000001>Branch of the vagus nerve that separates from the vagus well postcranially, then continues anteriorly to innervate the larynx[AAO:0010754].</obo:UBPROP_0000001>
        <oboInOwl:hasBroadSynonym>recurrent nerve</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>AAO:0010754</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:6246</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:804</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D012009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:24227007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001347</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Recurrent_laryngeal_nerve</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>nervus laryngeus recurrens</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>recurrent laryngeal nerve from vagus nerve</oboInOwl:hasExactSynonym>
