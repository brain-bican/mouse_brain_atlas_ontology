    <!-- http://purl.obolibrary.org/obo/UBERON_0003045 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005838"/>
        <obo:IAO_0000115>A fiber bundle containing fibers from nuclei of the hypothalamus that project to the dorsal tegmental nucleus and other regions of the midbrain and the pons, as well as fibers originating in the pontine reticular formation and the medullary reticular formation that project to the thalamus and other regions of the forebrain (Carpenter-83). In NeuroNames it is a composite structure consisting of the dorsal longitudinal fasciculus of hypothalamus, the dorsal longitudinal fasciculus of midbrain, the dorsal longitudinal fasciculus of pons and the dorsal longitudinal fasciculus of medulla. (NeuroNames).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BAMS:VCo</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:dlf</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:986</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:12035</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:83845</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:9348</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:547</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Dorsal_longitudinal_fasciculus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005266</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:722</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>bundle of Schutz</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fasciculus longitudinalis posterior</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fasciculus of Schutz</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>posterior longitudinal fasciculus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>DLF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>accessory cochlear nucleus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>dorsal longitudinal fascicle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>fasciculus longitudinalis dorsalis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>fasciculus longitudinalis posterior</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus acustici accessorici</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus cochlearis anterior</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus cochlearis ventralis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ventral cochlear nuclei</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ventral division of cochlear nucleus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003045</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:label>dorsal longitudinal fasciculus</rdfs:label>
        <skos:prefLabel>dorsal longitudinal fasciculus</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003045"/>
