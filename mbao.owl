        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>respiratory airway</rdfs:label>
        <skos:prefLabel>respiratory airway</skos:prefLabel>
