        <oboInOwl:hasExactSynonym>medial raphe nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>median nucleus of the raphe</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nucleus raphes medianus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>superior central nucleus</oboInOwl:hasExactSynonym>
