        <oboInOwl:hasDbXref>FMA:72257</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:1017</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:666</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ansiform lobule of cerebellum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ansiform lobule of cerebellum [hVIIa]</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lobuli semilunares cerebelli</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lobulus ansiformis cerebelli</oboInOwl:hasExactSynonym>
