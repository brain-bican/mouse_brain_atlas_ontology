        <oboInOwl:hasRelatedSynonym>fasciculus medialis telencephalicus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>fasciculus prosencephalicus medialis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>medial forebrain bundles</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>median forebrain bundle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001910</oboInOwl:id>
