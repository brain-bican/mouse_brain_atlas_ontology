    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004073"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>The interposed nucleus is a deep nucleus of the cerebellum and is composed of the globose nuclei and the emboliform nuclei. It is located in in the roof (dorsal aspect) of the fourth ventricle, lateral to the fastigial nucleus. It receives its afferent supply from the anterior lobe of the cerebellum and sends output via the superior cerebellar peduncle to the red nucleus.</owl:annotatedTarget>
        <oboInOwl:source>Wikipedia:Interposed_nucleus</oboInOwl:source>
    </owl:Axiom>
