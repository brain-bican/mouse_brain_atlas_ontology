        <obo:IAO_0000115>The parvocellular reticular nucleus is part of the brain located dorsolateral to the nucleus reticularis pontis caudalis. The dorsal portion of the reticular nucleus has been shown to innervate the mesencephalic trigeminal nucleus and its surrounding area. Also, it projects to the facial nucleus, hypoglossal nucleus and parabrachial nucleus along with parts of the caudal parvocellular reticular formation. This nucleus is also involved in expiration with a part of the gigantocellular nucleus.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>DHBA:12618</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:72575</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:9624</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:852</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Parvocellular_reticular_nucleus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:728</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>nucleus reticularis parvocellularis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>parvicellular reticular nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>parvocellular reticular nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus parvocellularis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus reticularis parvicellularis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus reticularis parvocellaris</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus reticularis parvocellularis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>parvicellular reticular nucleus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>parvocellular nucleus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>parvocellular reticular nucleus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0016633</oboInOwl:id>
        <rdfs:label>parvocellular reticular nucleus</rdfs:label>
        <skos:prefLabel>parvocellular reticular nucleus</skos:prefLabel>
    </owl:Class>
