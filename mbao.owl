        <oboInOwl:hasRelatedSynonym>septum nasi</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>septum of the nose</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001706</oboInOwl:id>
