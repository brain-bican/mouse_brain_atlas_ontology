        <oboInOwl:id>UBERON:0005090</oboInOwl:id>
        <rdfs:label>muscle structure</rdfs:label>
        <skos:prefLabel>muscle structure</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005090"/>
