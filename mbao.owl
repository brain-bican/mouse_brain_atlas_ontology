    <!-- http://purl.obolibrary.org/obo/UBERON_0002985 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002985">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015233"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001927"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Ventral division of medial geniculate body, first described by Morest (1964) in the cat, but found in primate, mouse and rat as well. It begins midway in the posterior third of the medial geniculate in the cat and is prominant anteriorly. The boundary between the dorsal and ventral divisions is demarcated in rat by a thick horizontally oriented axon bundle, the midgeniculate bundle (Webster, 1995, fig 16).</obo:IAO_0000115>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002758"/>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002759"/>
        <oboInOwl:hasBroadSynonym>MGV</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>VMG</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BAMS:MGV</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:MGv</oboInOwl:hasDbXref>
