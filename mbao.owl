        <owl:annotatedTarget rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>
        <oboInOwl:source>https://github.com/obophenotype/uberon/issues/2495#issuecomment-1187364719</oboInOwl:source>
    </owl:Axiom>
    


