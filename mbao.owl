        <oboInOwl:source>MA</oboInOwl:source>
        <oboInOwl:source>NIFSTD</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008933"/>
