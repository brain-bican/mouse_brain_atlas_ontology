        <oboInOwl:hasDbXref>VHOG:0001131</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Superior_oblique_muscle</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000738</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>dorsal oblique extraocular muscle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>musculus obliquus superior</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>obliquus superior</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>superior oblique</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>superior oblique muscle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>M. obliquus superior</oboInOwl:hasRelatedSynonym>
