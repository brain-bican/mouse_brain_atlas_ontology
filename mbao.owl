        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000003"/>
        <owl:annotatedTarget>(...) the substantia nigra first appears in reptiles and is best developed in primates.[well established][VHOG]</owl:annotatedTarget>
