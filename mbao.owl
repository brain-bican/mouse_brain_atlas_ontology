        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>archaeocerebellum</owl:annotatedTarget>
        <oboInOwl:hasDbXref>BIRNLEX:904</oboInOwl:hasDbXref>
    </owl:Axiom>
