        <owl:annotatedTarget rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000161"/>
        <oboInOwl:source>FMA</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000166"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The orifice that connects the mouth to the exterior of the body.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://github.com/obophenotype/uberon/wiki/The-digestive-tract</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000166"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000003"/>
        <owl:annotatedTarget>(...) mouth development is very similar in protostomes and &apos;basal&apos; deuterostomes, whereas the chordate mouth seems to develop at a new position. Recent data for echinoderms and hemichordates further suggest that this change in mouth position may result from change in the influence of a conserved ectodermal patterning system on mouth development. It has been suggested that the mouths of vertebrates and urochordates may constitute a &apos;new&apos; mouth.[well established][VHOG]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-09-17</oboInOwl:date_retrieved>
        <oboInOwl:external_class>VHOG:0000280</oboInOwl:external_class>
        <oboInOwl:ontology>VHOG</oboInOwl:ontology>
        <oboInOwl:source>DOI:10.1016/j.semcdb.2007.06.002 Christiaen L, Jaszczyszyn Y, Kerfant M, Kanob S, Thermes V, Joly JS, Evolutionary modification of mouth position in deuterostomes. Seminars in Cell and Developmental Biology (2007)</oboInOwl:source>
        <oboInOwl:source>http://bgee.unil.ch/</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000166"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>oral fissure</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FMA:59806</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000166"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>oral orifice</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FMA:59806</oboInOwl:hasDbXref>
    </owl:Axiom>
