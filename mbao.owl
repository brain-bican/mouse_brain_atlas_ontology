        <oboInOwl:hasRelatedSynonym>t. olivocerebellaris</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tractus olivocerebellaris</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002752</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>olivocerebellar tract</rdfs:label>
        <skos:prefLabel>olivocerebellar tract</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/9/93/Gray695.png</foaf:depiction>
    </owl:Class>
