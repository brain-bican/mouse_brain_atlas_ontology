                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000115"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A layer of epithelium that lines the heart, blood vessels (endothelium, vascular), lymph vessels (endothelium, lymphatic), and the serous cavities of the body[MESH]. Simple squamous epithelium which lines blood and lymphatic vessels and the heart[FMA].</obo:IAO_0000115>
        <obo:UBPROP_0000007>endothelial</obo:UBPROP_0000007>
        <oboInOwl:hasDbXref>BTO:0000393</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0278</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EFO:0002548</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:63916</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:520</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D004727</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12481</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:27168002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0014257</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Endothelium</oboInOwl:hasDbXref>
        <oboInOwl:id>UBERON:0001986</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:comment>The term &apos;endothelium&apos; has been either restricted to the continuous cell layer of the vertebrates, as we are assuming here, or applied to all the cells able to adhere to the luminal surface of the vascular basement membrane (Casley-Smith 1980)</rdfs:comment>
        <rdfs:label>endothelium</rdfs:label>
        <skos:prefLabel>endothelium</skos:prefLabel>
    </owl:Class>
