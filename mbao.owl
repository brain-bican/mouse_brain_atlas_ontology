            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002433"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002037"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Four accumulations of gray substance embedded in the white substance of the cerebellum, comprising the nucleus dentatus, nucleus emboliformis, nucleus globosus, and nucleus fastigii.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_119203"/>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_1476529"/>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_32524"/>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_7878"/>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_7896"/>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_8292"/>
        <obo:UBPROP_0000008>One or more deep cerebellar nuclei appear in agnathans, sharks, ropefishes, lungfishes, Latimeria, and amphibians. Reptiles have two nuclei (a medial and a lateral), and birds and mammals have three nuclei (a medial, a lateral, and an interposed nucleus). The medial nucleus of mammals is known as the fastigial nucleus, and the lateral nucleus is known as the dentate nucleus.[BgeeDb][ISBN:0471888893]</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref>BTO:0003835</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:35272</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:321695</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000203</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:279220006</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cerebellar nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>deep cerebellar nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0008995</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>nucleus of cerebellar nuclear complex</rdfs:label>
        <skos:prefLabel>nucleus of cerebellar nuclear complex</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008995"/>
