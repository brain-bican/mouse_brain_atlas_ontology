    <!-- http://purl.obolibrary.org/obo/UBERON_0007703 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007703">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007702"/>
        <obo:IAO_0000115>A tract that originates from neurons in the spinal central gray and projects to various somatosensory nuclei of the thalamus. It is formed in the medulla by merger of the anterior spinothalamic tract and lateral spinothalamic tract (adapted from Braininfo.org).</obo:IAO_0000115>
        <obo:UBPROP_0000001>a long process of a CNS neuron, that carries efferent (outgoing) action potentials from the cell body in the spinal cord towards target cells in the thalamus. This axonal process is a member of those that make up the spinothalamic tract, one of the major routes of nociceptive signaling[GO][GO:0021963].</obo:UBPROP_0000001>
        <oboInOwl:hasDbXref>BAMS:spth</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:stt</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BTO:0006128</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:12789</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:871</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D013133</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NLXANAT:1010017</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:280417000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Spinothalamic_tract</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:2058</oboInOwl:hasDbXref>
        <oboInOwl:id>UBERON:0007703</oboInOwl:id>
        <rdfs:label>spinothalamic tract</rdfs:label>
        <skos:prefLabel>spinothalamic tract</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/b/b2/Spinal_cord_tracts_-_English.svg</foaf:depiction>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007703"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A tract that originates from neurons in the spinal central gray and projects to various somatosensory nuclei of the thalamus. It is formed in the medulla by merger of the anterior spinothalamic tract and lateral spinothalamic tract (adapted from Braininfo.org).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>NLXANAT:1010017</oboInOwl:hasDbXref>
