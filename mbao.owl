        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Bony structure that encases the central nervous system and the primary sense organs of sight, olfaction, hearing, and equilibrium.[AAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-06-20</oboInOwl:date_retrieved>
        <oboInOwl:external_class>AAO:0000109</oboInOwl:external_class>
        <oboInOwl:ontology>AAO</oboInOwl:ontology>
        <oboInOwl:source>AAO:LAP</oboInOwl:source>
