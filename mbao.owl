        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_yeast"/>
        <rdfs:label>ribosome</rdfs:label>
        <skos:prefLabel>ribosome</skos:prefLabel>
    </owl:Class>
