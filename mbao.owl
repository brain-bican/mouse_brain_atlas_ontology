    <!-- http://purl.obolibrary.org/obo/UBERON_0014450 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0014450">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002308"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001944"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A neural nucleus of the pretectal area (between dorsal thalamus and optic tectum) that receives afferents primarily from the retina and the optic tectum and are involved in modulating motor behavior in response to visual input.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_7761"/>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9255"/>
        <obo:UBPROP_0000001>Any of the groups of neurons located between the thalamus and midbrain that receive binocular sensory input from retinal ganglion cells of the eyes and are responsible for maintaining the pupillary light reflex</obo:UBPROP_0000001>
        <obo:UBPROP_0000008>in hagfishes, there are two: the pretectal nucleus and the nucleus of the posterior commissure[ISBN:0471888893]</obo:UBPROP_0000008>
        <obo:UBPROP_0000012>see notes for pretectal region. Note this is midbrain in FMA, midbrain (mesencephalon) in HBA, midbrain in DHBA</obo:UBPROP_0000012>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <oboInOwl:hasAlternativeId>UBERON:0002994</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>BAMS:PTA</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:864</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:12182</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:37919</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:72401</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:9083</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:416164009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0175358</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:468</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>nucleus of pretectal area</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pretectal area nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pretectal nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus area pretectalis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus of the pretectal area</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0014450</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>pretectal nucleus</rdfs:label>
        <skos:prefLabel>pretectal nucleus</skos:prefLabel>
    </owl:Class>
