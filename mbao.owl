    <!-- http://purl.obolibrary.org/obo/UBERON_0004089 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004089">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001444"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001456"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002162"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_89593"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002433"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001456"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The middle of the face including the nose and its associated bony structures[MW].</obo:IAO_0000115>
        <obo:IAO_0000116>this class is currently a union of the snout (e.g. in mouse), the midface and the lower face. Note that in MA, snout includes the whole jaw and should thus be more alike the lower face than the midface, so its placement here is not strictly accurate. In future we might introduce specific classes for each of these, and include the full parthood relationships. if this is done, then care should be taken to preserve inferences such as an abnormality of the lower face being an abnormality of the midface.</obo:IAO_0000116>
        <obo:UBPROP_0000007>midfacial</obo:UBPROP_0000007>
        <oboInOwl:hasDbXref>FMA:285406</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001910</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>lower face</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>midface/lower face</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>snout</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0004089</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>midface</rdfs:label>
        <skos:prefLabel>midface</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004089"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The middle of the face including the nose and its associated bony structures[MW].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>HP:0000309</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>http://www.merriam-webster.com/medical/midface</oboInOwl:hasDbXref>
