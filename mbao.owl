    <!-- http://purl.obolibrary.org/obo/UBERON_0006215 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006215">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001048"/>
