        <oboInOwl:hasDbXref>Wikipedia:Otic_placode</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000223</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000138</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>placoda otica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>auditory placode</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ear placode</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ear/otic placode</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>octaval VIII placode</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>octaval placode</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003069</oboInOwl:id>
