        <oboInOwl:hasExactSynonym>oriens layer of the hippocampus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>polymorphic layer of hippocampus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>polymorphic layer of the hippocampus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stratum oriens</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stratum oriens hippocampi</oboInOwl:hasExactSynonym>
