        <oboInOwl:hasDbXref>BTO:0002444</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:10349</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:35164</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:77700</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:4300</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D066187</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PBA:128012976</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Basal_forebrain</oboInOwl:hasDbXref>
