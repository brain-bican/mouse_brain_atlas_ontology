    <!-- http://purl.obolibrary.org/obo/UBERON_0010415 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010415">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0035014"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003942"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf rdf:nodeID="genid12462"/>
