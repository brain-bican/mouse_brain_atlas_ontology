        <skos:prefLabel>trigeminal sensory nucleus</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/3/30/Gray696.png</foaf:depiction>
    </owl:Class>
