        <rdfs:subClassOf rdf:nodeID="genid11276"/>
        <obo:IAO_0000115>The predominant portion of the globus pallidus in the striatopallidal system, which is defined by connectivity and neurochemical staining. The dorsal pallidum is distinguished from the ventral pallidum by a boundary that is partially defined by the anterior commissure. The remainder of the boundary is indistinct in sections stained for Nissl substance ( Heimer-1995 ).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BAMS:PALd</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BTO:0004376</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:77619</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:818</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1604</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>globus pallidus dorsal part</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>dorsal globus pallidus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pallidum dorsal region</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0006516</oboInOwl:id>
        <rdfs:label>dorsal pallidum</rdfs:label>
        <skos:prefLabel>dorsal pallidum</skos:prefLabel>
