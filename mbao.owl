        <oboInOwl:hasExactSynonym>thalamus ventralis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ventral thalamus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>perithalamus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>prethalamus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001900</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
