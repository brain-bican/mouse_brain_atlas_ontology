        <oboInOwl:hasRelatedSynonym>basement lamina</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lamina densa</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0005604</oboInOwl:id>
        <rdfs:comment>Note that this term has no relationship to &apos;membrane ; GO:0016020&apos; because the basement membrane is not a lipid bilayer.</rdfs:comment>
        <rdfs:label>basement membrane</rdfs:label>
        <skos:prefLabel>basement membrane</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0005604"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collagen-containing extracellular matrix consisting of a thin layer of dense material found in various animal tissues interposed between the cells and the adjacent connective tissue. It consists of the basal lamina plus an associated layer of reticulin fibers.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:22505934</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:33605520</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:39223427</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0005614 -->

