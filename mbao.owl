        <oboInOwl:hasDbXref>MA:0000935</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:564</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0175233</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Medial_septal_nucleus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:262</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>medial parolfactory nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>medial septum</oboInOwl:hasNarrowSynonym>
