        <oboInOwl:hasDbXref>UMLS:C0025055</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Medial_forebrain_bundle</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005111</oboInOwl:hasDbXref>
