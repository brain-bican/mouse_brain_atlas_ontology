    <!-- http://purl.obolibrary.org/obo/UBERON_0003077 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003077">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005291"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007524"/>
