    <!-- http://purl.obolibrary.org/obo/UBERON_0001134 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001134">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002036"/>
        <rdfs:subClassOf>
