    <!-- http://purl.obolibrary.org/obo/UBERON_0003098 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003098">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010371"/>
