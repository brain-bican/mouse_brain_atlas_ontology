            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An immature, nucleated erythrocyte occupying the stage of erythropoeisis that follows formation of erythroid progenitor cells. This cell is CD71-positive, has both a nucleus and a nucleolus, and lacks hematopoeitic lineage markers.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:83518</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>rubriblast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>pronormoblast</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#blood_and_immune_upper_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>proerythroblast</rdfs:label>
        <skos:prefLabel>proerythroblast</skos:prefLabel>
    </owl:Class>
