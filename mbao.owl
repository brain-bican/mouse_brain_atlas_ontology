        <oboInOwl:hasRelatedSynonym>caudal hematopoietic tissue</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>posterior ICM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>posterior blood island</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ventral blood island</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003061</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
