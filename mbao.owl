        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:label>prechordal plate</rdfs:label>
        <skos:prefLabel>prechordal plate</skos:prefLabel>
    </owl:Class>
