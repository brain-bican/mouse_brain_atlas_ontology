    <!-- http://purl.obolibrary.org/obo/UBERON_0007641 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007641">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007245"/>
