    <!-- http://purl.obolibrary.org/obo/UBERON_0004132 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004132">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002925"/>
