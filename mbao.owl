    <!-- http://purl.obolibrary.org/obo/UBERON_0014169 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0014169">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007702"/>
        <obo:IAO_0000115>The term nigrostriatal fibers refers to a dopaminergic fiber pathway connecting the substantia nigra with the striatum. It is not readily distinguished in myelin-stained cross-sections (Carpenter-83).</obo:IAO_0000115>
