    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000959">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007425"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/uberon/core#extends_fibers_into"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000941"/>
