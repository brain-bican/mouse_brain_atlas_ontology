        <oboInOwl:hasDbXref>Wikipedia:Ventral_cochlear_nucleus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:722</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>anterior cochlear nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>c1281209</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ventral cochlear nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>accessory cochlear nucleus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus acustici accessorici</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus cochlearis anterior</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus cochlearis ventralis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ventral cochlear nuclei</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ventral coclear nucleus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ventral division of cochlear nucleus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002828</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>ventral cochlear nucleus</rdfs:label>
        <skos:prefLabel>ventral cochlear nucleus</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/b/bb/Gray760.png</foaf:depiction>
    </owl:Class>
