    <!-- http://purl.obolibrary.org/obo/UBERON_0001579 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001579">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001785"/>
