        <oboInOwl:hasDbXref>MBA:874</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0262301</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001701</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:482</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>nucleus parabigeminalis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>corpus parabigeminum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus isthmi</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>parabigeminal nucleus (Bechterew)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>parageminal nucleus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002140</oboInOwl:id>
        <rdfs:label>parabigeminal nucleus</rdfs:label>
        <skos:prefLabel>parabigeminal nucleus</skos:prefLabel>
    </owl:Class>
