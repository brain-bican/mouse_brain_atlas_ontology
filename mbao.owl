    <!-- http://purl.obolibrary.org/obo/UBERON_0005413 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005413">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001018"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002316"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>This tract conveys interoceptive, proprioceptive, and exteroceptive information from the body&apos;s internal organs, and from the trunk, extremities, and neck region to the Cerebellum.</obo:IAO_0000115>
        <obo:UBPROP_0000001>The spinocerebellar tract is a set of axonal fibers originating in the spinal cord and terminating in the ipsilateral cerebellum. This tract conveys information to the cerebellum about limb and joint position[Wikipedia:Spinocerebellar_tract].</obo:UBPROP_0000001>
        <oboInOwl:hasDbXref>BAMS:sc</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:12749</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:733</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:85</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D020824</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NLX:60355</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NLXANAT:1005036</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Spinocerebellar_tract</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1978</oboInOwl:hasDbXref>
        <oboInOwl:id>UBERON:0005413</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>spinocerebellar tract</rdfs:label>
