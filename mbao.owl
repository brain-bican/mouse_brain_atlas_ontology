    <!-- http://purl.obolibrary.org/obo/GO_0030312 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0030312">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0110165"/>
        <rdfs:subClassOf>
            <owl:Restriction>
