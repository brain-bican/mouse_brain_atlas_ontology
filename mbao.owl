        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>presomitic mesoderm</rdfs:label>
        <skos:prefLabel>presomitic mesoderm</skos:prefLabel>
