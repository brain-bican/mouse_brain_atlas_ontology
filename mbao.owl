    <!-- http://purl.obolibrary.org/obo/UBERON_0004068 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004068">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009292"/>
        <rdfs:subClassOf rdf:nodeID="genid9571"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008816"/>
