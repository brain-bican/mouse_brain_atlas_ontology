    <!-- http://purl.obolibrary.org/obo/UBERON_0003081 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003081">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002050"/>
