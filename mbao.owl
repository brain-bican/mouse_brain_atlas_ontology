        <oboInOwl:hasExactSynonym>obscurus raphe nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>raphe obscurus nucleus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus raphC) obscurus</oboInOwl:hasRelatedSynonym>
