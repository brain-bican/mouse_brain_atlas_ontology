        <oboInOwl:hasDbXref>MA:0002971</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:485</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NLXANAT:1010001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PBA:10081</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Dorsal_striatum</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:2340</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>striatum dorsal region</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>caudoputamen</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>corpus striatum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>dorsal basal ganglia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>dorsal basal ganglion</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>striated body</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>striatum dorsale</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0005382</oboInOwl:id>
