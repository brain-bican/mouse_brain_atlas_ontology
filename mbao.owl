        <oboInOwl:hasRelatedSynonym>nuclei reticulares (thalami)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus reticularis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus reticulatus (thalami)</oboInOwl:hasRelatedSynonym>
