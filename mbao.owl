        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The sensory trigeminal nerve nuclei are the largest of the cranial nerve nuclei, and extend through the whole of the midbrain, pons and medulla. There is also a distinct trigeminal motor nucleus that is medial to the chief sensory nucleus[WP].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Trigeminal_nerve_nuclei</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
