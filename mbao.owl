        <owl:annotatedTarget>Nerve that carries information from the olfactory epithelium to the olfactory bulb[Butler and Hodos].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0471209627</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Olfactory_nerve</oboInOwl:hasDbXref>
