        <oboInOwl:hasDbXref>MA:0000909</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:369221008</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cortex of insula</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>insular neocortex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>ICx</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gray matter of insula</oboInOwl:hasRelatedSynonym>
