    <!-- http://purl.obolibrary.org/obo/UBERON_0002829 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002829">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001720"/>
        <obo:IAO_0000115>The dorsal cochlear nucleus (DCN, also known as the &apos;tuberculum acousticum&apos;), is a cortex-like structure on the dorso-lateral surface of the brainstem. Along with the ventral cochlear nucleus, it forms the cochlear nucleus, where all auditory nerve fibers from the cochlea form their first synapses. [WP,unvetted].</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>DCo</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BAMS:DC</oboInOwl:hasDbXref>
