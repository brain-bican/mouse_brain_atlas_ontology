    <!-- http://purl.obolibrary.org/obo/UBERON_0007193 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007193">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000200"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016525"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The inferior or orbital surface of the frontal lobe is concave, and rests on the orbital plate of the frontal bone. It is divided into four orbital gyri by a well-marked H-shaped orbital sulcus. These are named, from their position, the medial, anterior, lateral, and posterior orbital gyri. The medial orbital gyrus presents a well-marked antero-posterior sulcus, the olfactory sulcus, for the olfactory tract; the portion medial to this is named the straight gyrus, and is continuous with the superior frontal gyrus on the medial surface.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BAMS:OrG</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:256194</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:280372002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Orbital_gyri</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:91</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>orbital gyri</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>gyrus orbitales</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0007193</oboInOwl:id>
        <rdfs:label>orbital gyrus</rdfs:label>
        <skos:prefLabel>orbital gyrus</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/b/b1/Human_brainstem_anterior_view_2_description.JPG</foaf:depiction>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007193"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The inferior or orbital surface of the frontal lobe is concave, and rests on the orbital plate of the frontal bone. It is divided into four orbital gyri by a well-marked H-shaped orbital sulcus. These are named, from their position, the medial, anterior, lateral, and posterior orbital gyri. The medial orbital gyrus presents a well-marked antero-posterior sulcus, the olfactory sulcus, for the olfactory tract; the portion medial to this is named the straight gyrus, and is continuous with the superior frontal gyrus on the medial surface.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Orbital_gyri</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007193"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
