    <!-- http://purl.obolibrary.org/obo/UBERON_0002604 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002604">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006331"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006840"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009662"/>
        <rdfs:subClassOf rdf:nodeID="genid6293"/>
        <obo:IAO_0000115>The lateral lemniscus is a tract of axons in the brainstem that carries information about sound from the cochlear nucleus to various brainstem nuclei and ultimately the contralateral inferior colliculus of the midbrain. Three distinct, primarily inhibitory, cellular groups are located interspersed within these fibers, and are thus named the nuclei of the lateral lemniscus. [WP,unvetted].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BAMS:NLLv</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:VLL</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:1140</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BM:LLV</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:12457</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:72484</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:9200</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:99</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0175444</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Ventral_nucleus_of_the_lateral_lemniscus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:592</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>anterior nucleus of lateral lemniscus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nucleus anterior lemnisci lateralis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nucleus of the lateral lemniscus, ventral part</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ventral nucleus of the lateral lemniscus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus lemnisci lateralis pars ventralis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus lemnisci lateralis ventralis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus of the lateral lemniscus ventral part</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002604</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
