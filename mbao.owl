    <!-- http://purl.obolibrary.org/obo/UBERON_0002245 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002245">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002749"/>
