    <!-- http://purl.obolibrary.org/obo/CL_0000058 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000058">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002320"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0011026"/>
