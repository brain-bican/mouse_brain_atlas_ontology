    <!-- http://purl.obolibrary.org/obo/UBERON_0001703 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001703">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011158"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003128"/>
            </owl:Restriction>
        </rdfs:subClassOf>
