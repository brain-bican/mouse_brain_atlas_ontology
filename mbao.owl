    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002310"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid5329"/>
        <oboInOwl:notes>Need to determine whether the fimbria is part of the fornix. Sometimes the language suggests it isn&apos;t always thought of that way, but I see no useful reason why it should be separate; it all forms one continuous white matter tract. Neuronames and others include this as part of the hippocampal formation (MM)</oboInOwl:notes>
        <oboInOwl:source>NIFSTD</oboInOwl:source>
    </owl:Axiom>
