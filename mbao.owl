        <oboInOwl:hasExactSynonym>olfactory sensory organ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>main olfactory organ</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>primary olfactory organ</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>olfactory neuroepithelium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>organ olfactus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>organum olfactorium</oboInOwl:hasRelatedSynonym>
