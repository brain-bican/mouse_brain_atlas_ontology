        <oboInOwl:hasDbXref>Wikipedia:Subiculum</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:188</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>subicular cortex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>subiculum hippocampi</oboInOwl:hasExactSynonym>
