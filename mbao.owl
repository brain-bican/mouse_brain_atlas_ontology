                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0005576"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A structure that lies outside the plasma membrane and surrounds the entire cell or cells. This does not include the periplasmic space.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/geneontology/go-ontology/issues/31720</obo:IAO_0000233>
