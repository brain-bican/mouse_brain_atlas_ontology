        <rdfs:subClassOf rdf:nodeID="genid11862"/>
        <obo:IAO_0000115>The lateral recess is a projection of the fourth ventricle which extends into the inferior cerebellar peduncle of the brainstem. The lateral aperture, an opening in each extremity of the lateral recess, provides a conduit for cerebrospinal fluid to flow from the brain&apos;s ventricular system into the subarachnoid space.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>lateral recess</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BAMS:LR4V</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:V4r</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:12810</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:17257</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:78470</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:153</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:369283008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Lateral_recess</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:642</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>recessus lateralis (ventriculi quarti)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>fourth ventricle lateral recess</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lateral recess of the 4th ventricle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>recessus lateralis ventriculi quarti</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0007656</oboInOwl:id>
        <rdfs:label>lateral recess of fourth ventricle</rdfs:label>
        <skos:prefLabel>lateral recess of fourth ventricle</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/3/36/Gray768.png</foaf:depiction>
    </owl:Class>
