        <oboInOwl:hasExactSynonym>stratum lacunosum-moleculare</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0007640</oboInOwl:id>
        <rdfs:label>hippocampus stratum lacunosum moleculare</rdfs:label>
        <skos:prefLabel>hippocampus stratum lacunosum moleculare</skos:prefLabel>
    </owl:Class>
