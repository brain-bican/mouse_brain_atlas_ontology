        </rdfs:subClassOf>
        <obo:IAO_0000115>A mesenchymal stem cell capable of developing into blood vessel endothelium.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ZFA:0009258</oboInOwl:hasDbXref>
