    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001706">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003037"/>
        <rdfs:subClassOf rdf:nodeID="genid2442"/>
