        <owl:annotatedTarget>The bilaminar epithelium formed from the myotome and dermatome.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>AEO:0000214</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004290"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Epithelial sheet on the external surface of the somite that gives rise to trunk, muscle and dermis. Within the dermomyotome there is also a medio-lateral difference. The central region makes dermis, the mesenchymal connective tissue of the back skin. The medial region (closest to neural tube) makes epaxial muscle, and the lateral region (furthest from neural tube) makes hypaxial muscle[http://www.ncbi.nlm.nih.gov/bookshelf/br.fcgi?book=eurekah&amp;part=A66768].</owl:annotatedTarget>
        <oboInOwl:source>http://www.ncbi.nlm.nih.gov/bookshelf/br.fcgi?book=eurekah&amp;part=A66768</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004290"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Epithelial sheet on the external surface of the somite that gives rise to trunk, muscle and dermis.[TAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-08-14</oboInOwl:date_retrieved>
