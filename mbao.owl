        <owl:annotatedTarget>UMLS:C0085140</owl:annotatedTarget>
        <oboInOwl:source>BIRNLEX:1509</oboInOwl:source>
        <oboInOwl:source>ncithesaurus:Fore-Brain</oboInOwl:source>
    </owl:Axiom>
