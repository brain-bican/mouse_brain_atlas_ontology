        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:comment>previous some AOs had used the term &apos;axial skeleton&apos; to include the skull. This is being resolved (see tracker items above). Status: MA - fixed.</rdfs:comment>
        <rdfs:label>postcranial axial skeleton</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.obolibrary.org/obo/uberon/docs/The-axial-skeleton</rdfs:seeAlso>
        <skos:prefLabel>postcranial axial skeleton</skos:prefLabel>
    </owl:Class>
