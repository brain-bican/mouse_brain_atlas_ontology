        <obo:IAO_0000115>A neuron that releases catecholamine as a neurotransmitter.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6677-8489"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-05-18T12:07:45Z</terms:date>
