        <oboInOwl:hasDbXref>SCTID:361475002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000255</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1284009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000114</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Paraxial_mesoderm</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000259</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000255</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>paraxial mesenchyme</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>somitic mesoderm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>mesoderma paraxiale</oboInOwl:hasRelatedSynonym>
