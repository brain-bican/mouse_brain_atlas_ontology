        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002517"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The base of skull is the most inferior area of the skull, composed of the endocranium and lower parts of the skull roof.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Base_of_skull</oboInOwl:hasDbXref>
