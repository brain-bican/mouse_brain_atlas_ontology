                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_7711"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Embryologic structure that is formed by two longitudinal eminences, one on each alar plate of the midbrain. These eminences become the superior colliculus and inferior colliculus ( Carpenter-1983 )].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:77488</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1374</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lamina quadrigemina</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>quadrigeminal plate</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0006777</oboInOwl:id>
        <rdfs:comment>The term &quot;tectal plate&quot; (or &quot;quadrigeminal plate&quot;) is used to describe the junction of the gray and white matter in the embryo. (NeuroNames ancil-453)</rdfs:comment>
        <rdfs:label>tectal plate</rdfs:label>
        <skos:prefLabel>tectal plate</skos:prefLabel>
    </owl:Class>
