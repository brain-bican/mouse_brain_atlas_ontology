    <!-- http://purl.obolibrary.org/obo/UBERON_0007763 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007763">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004070"/>
        <rdfs:subClassOf rdf:nodeID="genid11903"/>
        <obo:IAO_0000115>The culmen is the portion of the anterior vermis adjacent to the primary fissure of cerebellum. The culmen and the anterior parts of the quadrangular lobules form the lobus culminis[WP].</obo:IAO_0000115>
        <obo:UBPROP_0000008>The culmen lobule (lobules IV/V) is a single structure in humans, but it is divided by the intraculminate fissure in many rodents. In some mouse strains such as SLJ/J, the intraculminate fissure is absent, in some strains such as DBA/2J it is present, and other strains (C57BL/10J and BALB/cJ) exhibit considerable variablility (PMID: 1953602).[MP]</obo:UBPROP_0000008>
        <obo:UBPROP_0000012>ABA splits culmen into IV and V and IV-V</obo:UBPROP_0000012>
        <oboInOwl:hasBroadSynonym>culmen</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BAMS:CUL</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:Cul</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:926</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:83886</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:928</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:279384001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:89649002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:659</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cerebellum culmen</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>culmen lobule</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neuraxis culmen</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>culmen of vermis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lobule IV and V of vermis</oboInOwl:hasRelatedSynonym>
