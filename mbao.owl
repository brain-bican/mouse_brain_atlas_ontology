    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004725">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002616"/>
        <rdfs:subClassOf>
