    <!-- http://purl.obolibrary.org/obo/UBERON_0002984 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002984">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015233"/>
        <rdfs:subClassOf rdf:nodeID="genid8233"/>
        <obo:IAO_0000115>The lateral dorsal nucleus is a nucleus of the thalamus. It acts in concert with the anterior nuclei of thalamus. It receives significant input from several subdivisions of visual cortex, and has a primary output to parietal cortex on the dorsolateral cortical convexity, giving it access to limbic forebrain nuclei important for emotion and behavior functions.</obo:IAO_0000115>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002679"/>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002681"/>
