        <oboInOwl:hasDbXref>FMA:85522</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:1306</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MAT:0000068</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D019170</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000068</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C34302</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000155</oboInOwl:hasDbXref>
