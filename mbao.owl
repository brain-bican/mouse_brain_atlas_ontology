        <oboInOwl:hasDbXref>NCIT:C33160</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:181197004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0027432</oboInOwl:hasDbXref>
