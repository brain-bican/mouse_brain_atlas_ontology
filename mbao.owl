    <!-- http://purl.obolibrary.org/obo/UBERON_0002211 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002211">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000122"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/uberon/core#extends_fibers_into"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001017"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
