        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:label>layer of retina</rdfs:label>
        <skos:prefLabel>layer of retina</skos:prefLabel>
    </owl:Class>
