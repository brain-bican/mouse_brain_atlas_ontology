        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:label>skeletal muscle tissue</rdfs:label>
        <skos:prefLabel>skeletal muscle tissue</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://upload.wikimedia.org/wikipedia/commons/c/c0/Skeletal_muscle.jpg</foaf:depiction>
