        <rdfs:comment>Note that this term is intended to annotate gene products that are not attached to the cell surface. For gene products at the cell surface, consider annotating to external side of plasma membrane ; GO:0009897.</rdfs:comment>
        <rdfs:label>extracellular region</rdfs:label>
        <skos:prefLabel>extracellular region</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0005576"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:curators</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0005604 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005604">
