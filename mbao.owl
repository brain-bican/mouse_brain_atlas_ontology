    <!-- http://purl.obolibrary.org/obo/CL_0000118 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0011005"/>
        <obo:IAO_0000115>Basket cells are inhibitory GABAergic interneurons of the brain. In general, dendrites of basket cells are free branching and contain smooth spines. Axons are highly branched. The branched axonal arborizations give rise to basket-like structures that surround the soma of the target cell. Basket cells form axo-somatic synapses, meaning their synapses target somas of other cells.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-2825-0621"/>
        <oboInOwl:hasDbXref>ZFA:0009068</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#BDS_subset"/>
        <rdfs:label>basket cell</rdfs:label>
        <skos:prefLabel>basket cell</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000118"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Basket cells are inhibitory GABAergic interneurons of the brain. In general, dendrites of basket cells are free branching and contain smooth spines. Axons are highly branched. The branched axonal arborizations give rise to basket-like structures that surround the soma of the target cell. Basket cells form axo-somatic synapses, meaning their synapses target somas of other cells.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WikipediaVersioned:Basket_cell&amp;oldid=951703880</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
