        <oboInOwl:hasDbXref>VHOG:0001700</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Dentate_nucleus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:683</oboInOwl:hasDbXref>
