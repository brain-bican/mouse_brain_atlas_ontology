        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Any of the groups of neurons located between the thalamus and midbrain that receive binocular sensory input from retinal ganglion cells of the eyes and are responsible for maintaining the pupillary light reflex</owl:annotatedTarget>
