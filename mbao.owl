        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000012"/>
        <owl:annotatedTarget>in MA and FMA this is part of the pons / pontime tegmentum. We weaken this to overlaps to avoid inconsistency. In NIF this is a composite structure spanning multiple regions, which is more appropriate.</owl:annotatedTarget>
        <oboInOwl:external_ontology>MA</oboInOwl:external_ontology>
    </owl:Axiom>
