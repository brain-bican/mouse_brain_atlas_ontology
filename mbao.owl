    <!-- http://purl.obolibrary.org/obo/UBERON_0016641 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0016641">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006569"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010225"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The term subparafascicular nucleus refers to a cell group located ventral to the parafascicular nucleus in the thalamus. Identified by internal structure, it is present in the human ( Mai-1997 ), the macaque ( Paxinos-2009a ), the rat ( Swanson-1998 ), and the mouse ( Hof-2000 ).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>DHBA:13054</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:226239</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MBA:406</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:2253</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>nucleus subparafascicularis thalami</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>subparafascicular nucleus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>subparafascicular nucleus of the thalamus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>subparafascicular nucleus thalamus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>subparafascicular thalamic nucleus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0016641</oboInOwl:id>
        <rdfs:label>subparafascicular nucleus</rdfs:label>
        <skos:prefLabel>subparafascicular nucleus</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
