    <!-- http://purl.obolibrary.org/obo/UBERON_0001982 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001982">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_8410081"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002176"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001979"/>
