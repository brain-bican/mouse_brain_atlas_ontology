        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000012"/>
        <owl:annotatedTarget>part of diencephalon in ZFA - modify to adjacent here, supported by pub. Note there is some inconsistency in resources between the region vs nuclei - sometimes they are treated equivalent, sometimes separate (e.g. MP)</owl:annotatedTarget>
        <oboInOwl:external_ontology>ZFA</oboInOwl:external_ontology>
