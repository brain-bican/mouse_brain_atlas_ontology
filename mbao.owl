        <oboInOwl:hasNarrowSynonym>oligodendrocyte myelin sheath</oboInOwl:hasNarrowSynonym>
        <oboInOwl:id>GO:0043209</oboInOwl:id>
        <rdfs:label>myelin sheath</rdfs:label>
        <skos:prefLabel>myelin sheath</skos:prefLabel>
