    <!-- http://purl.obolibrary.org/obo/UBERON_0001434 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001434">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011216"/>
