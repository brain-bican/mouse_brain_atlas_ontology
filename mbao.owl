    <!-- http://purl.obolibrary.org/obo/UBERON_8440005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_8440005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0035014"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006569"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002131"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002622"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002131"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002625"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002131"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002690"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A functional anatomical construct containing the key estrogen-regulated inputs to gonadotropin-releasing hormone expressing (GnRH) neurons necessary for estrogen positive feedback. The rostral periventricular region of the third ventricle contains a population of neurons, scattered through the nuclei of the anteroventral periventricular (AVPV), periventricular preoptic (PVpo), and median preoptic (MEPO), that project directly to GnRH neurons and express ER-alpha.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>RP3V</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:8440005</oboInOwl:id>
        <rdfs:comment>In rats and mice, the anteroventral periventricular nucleus plus the periventricular nucleus make up the rostral periventricular region of the third ventricle (RP3V). Overlaps is used (instead of has_part that this comment suggests should be used) as PMID:17604108 suggest that the region refers to cells that are scattered in the area.</rdfs:comment>
        <rdfs:label>rostral periventricular region of the third ventricle</rdfs:label>
        <skos:prefLabel>rostral periventricular region of the third ventricle</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_8440005"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A functional anatomical construct containing the key estrogen-regulated inputs to gonadotropin-releasing hormone expressing (GnRH) neurons necessary for estrogen positive feedback. The rostral periventricular region of the third ventricle contains a population of neurons, scattered through the nuclei of the anteroventral periventricular (AVPV), periventricular preoptic (PVpo), and median preoptic (MEPO), that project directly to GnRH neurons and express ER-alpha.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:17604108</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_8440005"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>RP3V</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:17604108</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_8440005"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>In rats and mice, the anteroventral periventricular nucleus plus the periventricular nucleus make up the rostral periventricular region of the third ventricle (RP3V). Overlaps is used (instead of has_part that this comment suggests should be used) as PMID:17604108 suggest that the region refers to cells that are scattered in the area.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WikipediaVersioned:Anteroventral_periventricular_nucleus&amp;oldid=966137187</oboInOwl:hasDbXref>
    </owl:Axiom>
    


