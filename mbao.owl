    <!-- http://purl.obolibrary.org/obo/UBERON_0022303 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0022303">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005162"/>
