    <!-- http://purl.obolibrary.org/obo/GO_0005576 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005576">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0110165"/>
        <obo:IAO_0000115>The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/geneontology/go-ontology/issues/31545</obo:IAO_0000233>
        <oboInOwl:hasDbXref>Wikipedia:Extracellular</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>extracellular</oboInOwl:hasExactSynonym>
        <oboInOwl:id>GO:0005576</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_agr"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_candida"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_chembl"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_drosophila"/>
