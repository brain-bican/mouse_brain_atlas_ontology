        <oboInOwl:hasRelatedSynonym>ventral spinocerebellar tract (Gowers)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002987</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>anterior spinocerebellar tract</rdfs:label>
        <skos:prefLabel>anterior spinocerebellar tract</skos:prefLabel>
