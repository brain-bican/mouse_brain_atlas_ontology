    <!-- http://purl.obolibrary.org/obo/UBERON_0001882 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001882">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009663"/>
