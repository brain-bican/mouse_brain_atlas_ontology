    <!-- http://purl.obolibrary.org/obo/UBERON_0000483 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000483">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000479"/>
        <rdfs:subClassOf>
