            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Axons of neurons encased in a lipoproteinaceous material called myelin. (MeSH).</obo:IAO_0000115>
        <obo:IAO_0000116>consider adding link to UBERON:0002316 ! white matter of neuraxis</obo:IAO_0000116>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_117569"/>
