    <owl:Ontology rdf:about="https://purl.brain-bican.org/ontology/mbao/mbao.owl">
        <owl:versionIRI rdf:resource="https://purl.brain-bican.org/ontology/mbao/releases/2026-11-05/mbao.owl"/>
        <obo:IAO_0000700 rdf:resource="https://purl.brain-bican.org/ontology/mbao/MBA_997"/>
        <terms:description>An application ontology built by combining ontologised versions of the Allen Institute Mouse Brain Atlas (MBA) StructureGraph mapped to Uberon.</terms:description>
        <terms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <terms:title>Mouse Brain Atlas Ontology</terms:title>
        <owl:versionInfo>2026-11-05</owl:versionInfo>
    </owl:Ontology>
    


