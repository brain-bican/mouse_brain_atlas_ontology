        <oboInOwl:hasDbXref>NCIT:C49301</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C52707</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:244781004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0448325</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1710437</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001390</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Muscles_of_tongue</oboInOwl:hasDbXref>
