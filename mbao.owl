    <!-- http://purl.obolibrary.org/obo/UBERON_0002241 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011159"/>
