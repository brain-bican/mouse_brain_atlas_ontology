    <!-- http://purl.obolibrary.org/obo/UBERON_0003007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007634"/>
        <rdfs:subClassOf rdf:nodeID="genid8400"/>
        <obo:IAO_0000115>The lateral parabrachial nucleus induces thirst by stimulating the median preoptic nucleus. It gets its name from its location relative to the superior cerebellar peduncles, which is also known as the &apos;brachia conjunctiva&apos;. [WP,unvetted].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BAMS:LPB</oboInOwl:hasDbXref>
