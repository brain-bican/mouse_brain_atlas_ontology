# Class: <http://purl.obolibrary.org/obo/UBERON_0001840> (semicircular canal)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Semicircular_canal") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001840> "One of three half-circular, interconnected tubes located inside each ear[WP].")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-08-14") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "TAO:0000431") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "TAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ZFIN:curator") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001840> "Fluid-filled toroidal spaces, arranged orthogonally to each other in the ear, that detect angular accelerations. (See Anatomical Atlas entry for semicircular canals by T. Whitfield.)[TAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0001144") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ISBN:978-0030223693 Liem KF, Bemis WE, Walker WF, Grande L, Functional Anatomy of the Vertebrates: An Evolutionary Perspective (2001) p.414") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") <http://purl.obolibrary.org/obo/UBPROP_0000003> <http://purl.obolibrary.org/obo/UBERON_0001840> "In gnathostomes, each membranous labyrinth has three semicircular ducts that connect with a chamber known as the utriculus. These ducts are sometimes called canals, but technically the term semicircular canal applies to the spaces in the osseus labyrinth in which the semicircular ducts lie.[uncertain][VHOG]")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000009> <http://purl.obolibrary.org/obo/UBERON_0001840> "detects angular acceleration")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#external_ontology> "MA") <http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0001840> "MA divides this into osseous and duct. In FMA, this is systemically part of the bony labyrinth. Note this is an anatomical space in ZFA. The MA treatment has advantages for representing the neuroepithelium, which should not be part of bone. Also check duct vs canal")
