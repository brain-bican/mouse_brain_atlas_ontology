# Class: <http://purl.obolibrary.org/obo/UBERON_0005382> (dorsal striatum)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NLXANAT:1010001") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0005382> "Dorsal components of the striatum comprising the caudate nucleus and the putamen, in species that have distinct nuclei; the caudoputamen in species which don't.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "Wikipedia:Dorsal_striatum") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0005382> "According to BrainInfo it is a part of the basal ganglia comprising the globus pallidus and striatum")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "Wikipedia:Dorsal_striatum") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0005382> "According to the 1917 version of Gray's Anatomy, it is the combination of the lentiform nucleus (putamen and the globus pallidus) and the caudate nucleus")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "Wikipedia:Dorsal_striatum") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0005382> "It may also refer to both the basal ganglia and the internal capsule collectively.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "Wikipedia:Dorsal_striatum") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0005382> "It may also refer to the putamen and caudate collectively.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "neuronames:2340") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0005382> "The term dorsal striatum refers to a composite structure of the endbrain that is defined in the striatopallidal system by connectivity and neurochemical staining. It includes most of the striatum ( Heimer-1995 ). The boundary between this structure and the ventral striatum is indistinct in sections stained for Nissl substance.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0005382> "BAMS:Dorsal_striatum")
