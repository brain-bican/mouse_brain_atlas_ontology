AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Culmen_(cerebellum)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0007763> "The culmen is the portion of the anterior vermis adjacent to the primary fissure of cerebellum. The culmen and the anterior parts of the quadrangular lobules form the lobus culminis[WP].")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0007763> "The culmen lobule (lobules IV/V) is a single structure in humans, but it is divided by the intraculminate fissure in many rodents. In some mouse strains such as SLJ/J, the intraculminate fissure is absent, in some strains such as DBA/2J it is present, and other strains (C57BL/10J and BALB/cJ) exhibit considerable variablility (PMID: 1953602).[MP]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#external_ontology> "ABA") <http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0007763> "ABA splits culmen into IV and V and IV-V")
