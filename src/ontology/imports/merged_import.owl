# Class: <http://purl.obolibrary.org/obo/UBERON_0001846> (internal ear)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16217737") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Internal_ear") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ZFIN:curator") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001846> "Complex labyrinthine structure that comprises sensory endorgans specialized for vestibular, auditory, and acoustico-vestibular sensation.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-08-14") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "TAO:0000217") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "TAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ZFIN:curator") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001846> "The auditory (hearing) and vestibular (balance) organ of the fish, equivalent to the inner ear of amniotes. (See Anatomical Atlas entry for ear by T. Whitfield.)[TAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0000284") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ISBN:978-0471090588 Hildebrand M, Analysis of vertebrate structure (1983) p.366") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") <http://purl.obolibrary.org/obo/UBPROP_0000003> <http://purl.obolibrary.org/obo/UBERON_0001846> "The labyrinth, or inner ear, evolved very early in vertebrate history and, with many variations in configuration but none of basic design and function, has been retained by all vertebrates.[well established][VHOG]")
