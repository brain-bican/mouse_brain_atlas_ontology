AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/UBERON_8410081> "microvessel")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_8410081> "UBERON:8410081")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_8410081> "blood microvessel")
AnnotationAssertion(rdfs:seeAlso <http://purl.obolibrary.org/obo/UBERON_8410081> "https://github.com/obophenotype/uberon/issues/2186")
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_8410081> <http://purl.obolibrary.org/obo/UBERON_0001981>)
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_8410081> <http://purl.obolibrary.org/obo/UBERON_0010523>)

# Class: <http://purl.obolibrary.org/obo/UBERON_8440000> (cortical layer II/III)

