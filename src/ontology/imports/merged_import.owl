# Class: <http://purl.obolibrary.org/obo/UBERON_0001020> (nervous system commissure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NLXANAT:20090513") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://github.com/obophenotype/uberon/issues/300") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://github.com/obophenotype/uberon/issues/325") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001020> "Axon tract that crosses the midline of the central nervous system[NIF, modified]. In the context of Drosophila refers to a broad band of axons connecting equivalent neuropils each side of the brain[FBbt].")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://neurolex.org/wiki/Cumbo_terms") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001020> "White matter fiber bundle that crosses the midline of the brain or spinal cord, that connects similar structures on both sides. (CUMBO; Heimer, L. The Human Brain, 2nd ed., 1995, pg 6)")
