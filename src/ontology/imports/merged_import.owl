AnnotationAssertion(<http://xmlns.com/foaf/0.1/depiction> <http://purl.obolibrary.org/obo/UBERON_0010262> "http://upload.wikimedia.org/wikipedia/commons/b/b3/Operculum.png"^^xsd:anyURI)
