AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NeuroNames:1853") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_0035596> "circular nucleus")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0035596> "UBERON:0035596")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/UBERON_0035596> "group of magnocellular elements arranged in a ring around a capillary bed. The cells are predominantly monopolar, tightly packed, and are flattened at the outer border of the ring. The entire nucleus is surrounded or encapsulated by myelinated fibers, hypothesized to be an osmoreceptor[PMID:974791]")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0035596> "circular nucleus of antherior hypothalamic nucleus")
