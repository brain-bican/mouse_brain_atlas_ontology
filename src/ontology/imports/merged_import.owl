SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "EHDAA2") <http://purl.obolibrary.org/obo/UBERON_0006268> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002202> <http://purl.obolibrary.org/obo/UBERON_0000924>))

