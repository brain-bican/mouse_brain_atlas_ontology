# Class: <http://purl.obolibrary.org/obo/UBERON_0035596> (circular nucleus of antherior hypothalamic nucleus)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NeuroNames:1853") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0035596> "A group of cells located in the central part of the anterior hypothalamic nucleus in the anterior hypothalamic region of the rat ( Swanson-2004 ) and the mouse ( Paxinos-2001 ). Functionally it belongs to the magnocellular neuroendocrine cell groups of the subcortical motor system ( Swanson-2004 ).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MBA:432") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003011>) <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/UBERON_0035596> "nucleus circularis")
