# Class: <http://purl.obolibrary.org/obo/UBERON_0001063> (flocculus)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0838580343") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MGI:csmith") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MP:0010006") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Flocculus_(cerebellar)") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://orcid.org/0000-0002-6601-2165") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001063> "The small lobe of the cerebellum at the posterior border of the middle cerebellar peduncle anterior to the biventer lobule that receives input from the inferior and medial vestibular nuclei and sends fibers back to the vestibular nuclei, and processes and integrates these signals to allow for the constant maintenance of balance.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ABA") <http://purl.obolibrary.org/obo/RO_0002171> <http://purl.obolibrary.org/obo/UBERON_0001063> <http://purl.obolibrary.org/obo/UBERON_0005347>)
