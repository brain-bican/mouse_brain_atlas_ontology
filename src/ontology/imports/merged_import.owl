AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VSAO:0000031") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VSAO:curator") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://github.com/obophenotype/uberon/issues/77") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0002204> "Anatomical system that consists of the muscular and skeletal systems.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-06-20") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "AAO:0010546") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "AAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "AAO:EJS") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0002204> "Anatomical system that provides locomotion and physical support to the organism.[AAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0001275") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "DOI:10.1002/jez.b.21246 Shearman RM, Burke AC, The lateral somitic frontier in ontogeny and phylogeny. Journal of Experimental Zoology (2009)") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") <http://purl.obolibrary.org/obo/UBPROP_0000003> <http://purl.obolibrary.org/obo/UBERON_0002204> "There are more than 50,000 extant vertebrate species, representing over 500 million years of evolution. During that time, the vertebrate musculoskeletal systems have adapted to aquatic, terrestrial, fossorial, and arboreal lifestyles, while simultaneously retaining functionally integrated axial and appendicular skeletal systems.[well established][VHOG]")
