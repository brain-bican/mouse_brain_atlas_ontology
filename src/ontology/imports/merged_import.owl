AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ABA") <http://purl.obolibrary.org/obo/RO_0002171> <http://purl.obolibrary.org/obo/UBERON_0001063> <http://purl.obolibrary.org/obo/UBERON_0005349>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ABA") <http://purl.obolibrary.org/obo/RO_0002171> <http://purl.obolibrary.org/obo/UBERON_0001063> <http://purl.obolibrary.org/obo/UBERON_0005350>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ABA") <http://purl.obolibrary.org/obo/RO_0002171> <http://purl.obolibrary.org/obo/UBERON_0001063> <http://purl.obolibrary.org/obo/UBERON_0005351>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PMID:14586467") <http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0001063> "enlarged in pterosaurs")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "WP") <http://purl.obolibrary.org/obo/UBPROP_0000009> <http://purl.obolibrary.org/obo/UBERON_0001063> "At its base, the flocculus receives input from the middle ears vestibular system and regulates balance. Many floccular projections descend to the spinal cord and connect to the motor nuclei involved in control of eye movement.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#external_ontology> "NIF") <http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0001063> "flocculus is an exact label for two distinct classes in NIF.")
