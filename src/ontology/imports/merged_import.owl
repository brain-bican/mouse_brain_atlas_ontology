AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0471888893") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Tela_chorioidea") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://isc.temple.edu/neuroanatomy/lab/embryo_new/choroid/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0005283> "A structure found in the walls of the ventricles of the brain, consisting of part of the meninges (pia mater in mammals) plus ependyma[cjm].")
