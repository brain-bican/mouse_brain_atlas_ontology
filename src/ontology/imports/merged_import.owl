AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0003067> "ZFA:0001310")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ZFA:0001310") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003004>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0003067> "dorsolateral placodes")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0003067> "UBERON:0003067")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/UBERON_0003067> "The only remaining dorsolateral placode in land vertebrates is the otic/octaval placode")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0003067> "dorsolateral placode")
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "NCBIBook:NBK53175") <http://purl.obolibrary.org/obo/UBERON_0003067> <http://purl.obolibrary.org/obo/UBERON_0009955>)
