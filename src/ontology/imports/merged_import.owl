SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "EHDAA2") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ZFA") <http://purl.obolibrary.org/obo/UBERON_0004290> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002202> <http://purl.obolibrary.org/obo/UBERON_0002329>))

