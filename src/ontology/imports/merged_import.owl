AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_8440003> "UBERON:8440003")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_8440003> "cortical layer VIb")
