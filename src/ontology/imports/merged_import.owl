AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.ncbi.nlm.nih.gov/books/NBK53175/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://github.com/obophenotype/uberon/issues/135") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://github.com/seger/aao/issues/4") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orcid.org/0000-0002-6601-2165") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://sourceforge.net/p/obo/xenopus-anatomy-xao-term-requests/11/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0002546> "Ectodermal placode that develops in the head into a part of the sensory nervous system. With a few exceptions (lens, adenohypophyseal), cranial placodes are neurogenic.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/UBERON_0002546> "Do not merge with neurogenic placode")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PMID:11523831") <http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0002546> "Comparisons of developmental gene expression suggest that the anterior ectoderm in amphioxus may be homologous to the vertebrate olfactory placode, the only vertebrate placode with primary, not secondary, neurons")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000013> <http://purl.obolibrary.org/obo/UBERON_0002546> "The term placode or placodes also applies to developing organs such as teeth, mammary glands, hair follicles, feathers and scales. We include a separate parent class for this. to avoid confusion, we include neurogenic placode as a subclass")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FMA:293966") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22512454") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/uberon/core#INCONSISTENT>) <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/UBERON_0002546> "ectodermal placode")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Placode") <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/UBERON_0002546> "placode")
