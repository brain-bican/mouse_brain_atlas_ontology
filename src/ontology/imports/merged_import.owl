SubClassOf(<http://purl.obolibrary.org/obo/UBERON_8440003> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0005395>))
