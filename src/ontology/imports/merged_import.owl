# Class: <http://purl.obolibrary.org/obo/UBERON_0002128> (superior olivary complex)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0-19-502694-2") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Superior_olivary_complex") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0002128> "A collection of brainstem nuclei that functions in multiple aspects of hearing and is an important component of the ascending and descending auditory pathways of the auditory system.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ABA") <http://purl.obolibrary.org/obo/RO_0002171> <http://purl.obolibrary.org/obo/UBERON_0002128> <http://purl.obolibrary.org/obo/UBERON_0002597>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ABA") <http://purl.obolibrary.org/obo/RO_0002171> <http://purl.obolibrary.org/obo/UBERON_0002128> <http://purl.obolibrary.org/obo/UBERON_0006840>)
