AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/RO_0002371> "attaches_to")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/RO_0002371> <http://purl.obolibrary.org/obo/ro/subsets#ro-eco>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#shorthand> <http://purl.obolibrary.org/obo/RO_0002371> "attaches_to")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002371> "attached to"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002371> "attached to")
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0002371> <http://purl.obolibrary.org/obo/RO_0002170>)
