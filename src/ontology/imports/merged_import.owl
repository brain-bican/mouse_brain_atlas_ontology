AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#shorthand> <http://purl.obolibrary.org/obo/RO_0002571> "lumen_of")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002571> "lumen of")
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0002571> <http://purl.obolibrary.org/obo/BFO_0000050>)

