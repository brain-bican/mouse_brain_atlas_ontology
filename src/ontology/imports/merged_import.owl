# Class: <http://purl.obolibrary.org/obo/UBERON_0001723> (tongue)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FEED:rd") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://github.com/obophenotype/uberon/issues/256") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001723> "A muscular organ in the floor of the mouth.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/UBERON_0001723> "in MA the tongue is part of the oral region, which in uberon is treated as the oral opening. consider revising oral opening - oral region equivalence.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0000419") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://medical-dictionary.thefreedictionary.com/tongue") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001723> "A mobile mass of muscular tissue that is covered with mucous membrane, occupies much of the cavity of the mouth, forms part of its floor, bears the organ of taste, and assists in chewing and swallowing. [TFD][VHOG]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-07-02") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "FEED") Annotation(<http://www.geneontology.org/formats/oboInOwl#url> "http://www.feedexp.org") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001723> "Muscular organ in the floor of the mouth.[FEED]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "GO:0043586") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001723> "The tongue is the movable, muscular organ on the floor of the mouth of most vertebrates, in many other mammals is the principal organ of taste, aids in the prehension of food, in swallowing, and in modifying the voice as in speech[GO][GO:0043586].")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0000419") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "DOI:10.1046/j.1469-7580.2002.00073.x Iwasaki S, Evolution of the structure and function of the vertebrate tongue. J Anat (2002)") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") <http://purl.obolibrary.org/obo/UBPROP_0000003> <http://purl.obolibrary.org/obo/UBERON_0001723> "Most adult amphibians have a tongue, as do all known reptiles, birds and mammals. Thus it is likely that the tongue appeared with the establishment of tetrapods and this structure seems to be related, to some extant, to the terrestrial lifestyle.[well established][VHOG]")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000007> <http://purl.obolibrary.org/obo/UBERON_0001723> "glossal")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000007> <http://purl.obolibrary.org/obo/UBERON_0001723> "lingual")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0001723> "Many species of fish have small folds at the base of their mouths that might informally be called tongues, but they lack a muscular structure like the true tongues found in most tetrapods")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000011> <http://purl.obolibrary.org/obo/UBERON_0001723> "The tongue has contributions from all pharyngeal arches which changes with time. The tongue initially begins as swelling rostral to foramen cecum, the median tongue bud.. tongue muscles derive from the somites - http://php.med.unsw.edu.au/embryology/index.php?title=Tongue_Development#Pharyngeal_Arch_Contributions")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0001723> "AAO:0010360")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0001723> "BTO:0001385")
