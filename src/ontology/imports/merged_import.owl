AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "BIRNLEX:904") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_0014642> "archicerebellum")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0014642> "UBERON:0014642")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0014642> "vestibulocerebellum")
