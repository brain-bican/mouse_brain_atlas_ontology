SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "FMA") <http://purl.obolibrary.org/obo/UBERON_0011821> <http://purl.obolibrary.org/obo/UBERON_0002384>)

# Class: <http://purl.obolibrary.org/obo/UBERON_0011822> (dense irregular connective tissue)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FMA:20109") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Dense_irregular_connective_tissue") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0011822> "Irregular connective tissue is an irregular connective tissue, the intercellular matrix of which contains a dense irregular network of collagen and elastic fiber bundles. Examples: connective tissue of peritoneum, connective tissue of fibrous pericardium.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-08-29") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "ncithesaurus:Irregular_Dense_Connective_Tissue") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "NCIT") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0011822> "Tissue characterized by a thick, random arrangement of collagen and elastin fibers with very few cells. The majority of the cells are fibroblasts, but mast cells and macrophages may also be seen. It is found in the dermis, periosteum, perichondrium, capsules of organs and sheaths of nerves and muscles[NCIT]")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0011822> "FMA:20109")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0011822> "NCIT:C32882")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ncithesaurus:Irregular_Dense_Connective_Tissue") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0011822> "UMLS:C0738366")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0011822> "Wikipedia:Dense_irregular_connective_tissue")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0011822> "irregular dense connective tissue")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FMA:20109") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0011822> "typus irregularis (textus connectivus collagenosus compactus)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0011822> "UBERON:0011822")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0011822> "dense irregular connective tissue")
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0011822> <http://purl.obolibrary.org/obo/UBERON_0011821>)
