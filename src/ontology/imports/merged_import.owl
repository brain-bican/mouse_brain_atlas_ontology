AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/UBERON_0001900> <http://purl.obolibrary.org/obo/uberon/core#uberon_slim>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/UBERON_0001900> <http://purl.obolibrary.org/obo/uberon/core#vertebrate_core>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/UBERON_0001900> "Some sources treat the subthalamus as distinct from the thalamus, separated by the zona limitans intrathalamica. In MA, the ventral thalamus is part of the thalamus. Butler Hodos who identify a dorsal to ventral sequence consisting of epithalamus, dorsal thalamus, ventral thalamus and hypothalamus. We solve this by considering dorsal and ventral thalamus distinct, and the label thalamus as being ambiguous w.r.t thalamus proper (dorsal thalamus) or wider thalamus (dorsal plus ventral)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0001900> "ventral thalamus")
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0001900> <http://purl.obolibrary.org/obo/UBERON_0002616>)
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0001900> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0001897>))
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0001900> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002433> <http://purl.obolibrary.org/obo/UBERON_0001894>))

# Class: <http://purl.obolibrary.org/obo/UBERON_0001903> (thalamic reticular nucleus)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Thalamic_reticular_nucleus") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001903> "The thalamic reticular nucleus is part of the ventral thalamus that forms a capsule around the thalamus laterally. It is separated from the thalamus by the external medullary lamina. Reticular cells are GABAergic, and have discoid dendritic arbors in the plane of the nucleus. Thalamic Reticular Nucleus is variously abbreviated TRN, RTN, NRT, and RT. [WP,unvetted].")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ABA") <http://purl.obolibrary.org/obo/RO_0002171> <http://purl.obolibrary.org/obo/UBERON_0001903> <http://purl.obolibrary.org/obo/UBERON_0001899>)
