AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "BTO:0002780") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "CLAO:0001295") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_8600004> "A muscle tissue that is associated with soft internal organs (viscera).")
